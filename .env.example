APP_NAME=AI Job Assistant
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://jobassistant:jobassistant@db:5432/jobassistant
SECRET_KEY=change-me-before-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# AI provider: none | openai | ollama
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=60

# Resume handling
MAX_RESUME_SIZE_MB=10
STORE_RESUME_FILES=false
RESUME_STORAGE_PATH=/tmp/ai-job-assistant/resumes
