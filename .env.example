APP_NAME=AI Job Assistant
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://jb:jb@db:5432/jobassistant
SECRET_KEY=change-me-before-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=60
EMBEDDING_DIMENSION=768
MAX_RESUME_SIZE_MB=10
STORE_RESUME_FILES=false
RESUME_STORAGE_PATH=/tmp/ai-job-assistant/resumes
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
JOB_PROVIDERS=remotive,arbeitnow
JOB_PROVIDER_TIMEOUT_SECONDS=30
GMAIL_ACCESS_TOKEN=
GMAIL_USER_ID=me
GMAIL_MONITOR_QUERY=newer_than:7d (interview OR recruiter OR application OR offer OR assessment)
EMAIL_PROVIDER_TIMEOUT_SECONDS=30
